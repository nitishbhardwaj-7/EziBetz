# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string for the api-server and drizzle-kit.
DATABASE_URL=postgresql://user:password@localhost:5432/postgres

# Port the local dev server listens on.
PORT=3000

# Signs and verifies auth JWTs. Required — the server refuses to start
# without it. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
